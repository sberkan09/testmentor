    "ServerEvent": {
      "additionalProperties": false,
      "description": "`WS /projects/{id}/events` message. `seq` grows by one per event within a project; a\nreconnecting client sends its last `seq` and receives the missed events, or a `snapshot`\nmessage when they are no longer kept.",
      "properties": {
        "seq": {
          "title": "Seq",
          "type": "integer"
        },
        "project_id": {
          "title": "Project Id",
          "type": "string"
        },
        "type": {
          "enum": [
            "command_applied",
            "command_rejected",
            "node_created",
            "node_updated",
            "node_removed",
            "node_stale",
            "job_started",
            "job_progress",
            "job_done",
            "job_failed",
            "stage_waiting_approval",
            "lock_changed"
          ],
          "title": "Type",
          "type": "string"
