          "default": "",
          "title": "Actor",
          "type": "string"
        },
        "payload": {
          "additionalProperties": true,
          "title": "Payload",
          "type": "object"
        }
      },
      "required": [
        "seq",
        "project_id",
        "type"
      ],
      "title": "ServerEvent",
      "type": "object"
    },
