# testmentor internetsiz kurulum: ortam dosyası. install.sh bunu .env olarak kopyalar ve
# anahtarları rastgele üretir. .env gizlidir: yedekle, paylaşma.
POSTGRES_PASSWORD=
LLM_API_KEY=
TESTMENTOR_AUTH_SECRET=

# Portlar (sunucuda kullanımdaysa değiştir)
APP_PORT=8080
POSTGRES_PORT=5432

# Model sunucusu boyutu (GPU belleği yetmezse küçült; KURULUM.md). Boş bırakılırsa paket varsayılanı.
#LLM_MAX_MODEL_LEN=32768
#LLM_MAX_NUM_SEQS=64
#LLM_GPU_MEMORY_UTILIZATION=0.8
#EMBEDDING_GPU_MEMORY_UTILIZATION=0.08

# Giriş: password (varsayılan) | header (yalnızca deneme)
#TESTMENTOR_AUTH_MODE=password
